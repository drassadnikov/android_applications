<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Дзен.Новости» 4x3: шапка (логотип + название + «Обновить»),
     строка статуса (время обновления + цветные стрелки курсов ЦБ),
     одна полоса рубрик с навигацией ‹ › (4 рубрики на страницу),
     ListView ленты новостей с вертикальным скроллингом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dzen_widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Шапка: логотип Дзен + название + кнопка «Обновить» -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/dzen_logo" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:text="⟳"
            android:textColor="#CCCCCC"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Строка статуса: время последнего обновления + курсы ЦБ (стрелки цветные) -->
    <TextView
        android:id="@+id/info_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="2dp"
        android:textColor="#888888"
        android:textSize="9sp" />

    <!-- Полоса рубрик: 4 рубрики + кнопки ‹ › -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/topic_prev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="‹"
            android:textColor="#888888"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/topic_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/topic_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/topic_c"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/topic_d"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/topic_next"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="›"
            android:textColor="#888888"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Лента новостей: вертикальный скроллинг -->
    <ListView
        android:id="@+id/news_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:scrollbars="none" />
</LinearLayout>
