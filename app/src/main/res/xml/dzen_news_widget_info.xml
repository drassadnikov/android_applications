<?xml version="1.0" encoding="utf-8"?>
<!-- Конфигурация виджета «Дзен.Новости» (Android 12+: targetCellWidth/Height) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="175dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/dzen_news_widget"
    android:initialKeyguardLayout="@layout/dzen_news_widget"
    android:previewImage="@drawable/dzen_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
