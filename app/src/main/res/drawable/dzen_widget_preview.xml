<?xml version="1.0" encoding="utf-8"?>
<!-- Превью виджета в лаунчере: тёмный фон + искра Дзен по центру.
     Внутренний размер 250x175dp (4x3) — лаунчер по нему даёт слот 4x3. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="250dp"
        android:height="175dp">
        <shape>
            <solid android:color="#121212" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#2C2C2C" />
        </shape>
    </item>
    <item
        android:width="44dp"
        android:height="44dp"
        android:drawable="@drawable/dzen_logo_star"
        android:gravity="center" />
</layer-list>
