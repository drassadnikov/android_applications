<?xml version="1.0" encoding="utf-8"?>
<!-- Оригинальный логотип Дзен: цветная «искра» (4 луча) на тёмном фоне.
     Градиент как у бренда: жёлто-оранжевый сверху → розово-маджента снизу. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Тёмный фон иконки -->
    <path
        android:fillColor="#121212"
        android:pathData="M0,0 h108 v108 h-108 z" />

    <!-- Искра Дзен: 4 луча с вогнутыми гранями -->
    <path android:pathData="M54,12
        C58.5,36.5 67.5,45.5 96,54
        C67.5,62.5 58.5,71.5 54,96
        C49.5,71.5 40.5,62.5 12,54
        C40.5,45.5 49.5,36.5 54,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="12"
                android:endX="54"
                android:endY="96">
                <item android:offset="0.0" android:color="#FFC400" />
                <item android:offset="0.45" android:color="#FF7A00" />
                <item android:offset="1.0" android:color="#E5187A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
